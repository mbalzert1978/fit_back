{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "HTTPS_PROXY": "http://127.0.0.1:3128",
    "HTTP_PROXY": "http://127.0.0.1:3128",
    "NO_PROXY": "localhost,127.0.0.1,::1"
  },
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(./make.ps1:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$CLAUDE_PROJECT_DIR/.claude/hooks/forbid-write-outside-worktree.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run \"$CLAUDE_PROJECT_DIR/.claude/hooks/prefer-jq-over-grep-json.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}