# Database Configuration
POSTGRES_DB=fit_back
POSTGRES_USER=fit_user
POSTGRES_PASSWORD=CHANGEME

DB_HOST=postgres
DB_PORT=5432
DB_NAME=fit_back
DB_USER=fit_user
DB_PASSWORD=CHANGEME

# MinIO Configuration
MINIO_ROOT_USER=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME

# App Security
# Signaturgeheimnis der Access-Token, mindestens 32 Zeichen. Ohne diesen Wert
# startet der Prozess nicht - siehe src/settings.py.
JWT_SECRET=CHANGEME-mindestens-32-zeichen-lang!!

# API
# Die Version, die `meta.apiVersion` und `info.version` nennen. Default: 1.
# Wer sie verstellt, verstellt das Pfadpraefix der Router mit - sonst nennt die
# Antwort eine andere Version als der Pfad, unter dem sie kam.
API_VERSION=1

# Token
# Geltungsdauern in Sekunden. Defaults: 900 (15 Minuten) und 5184000 (60 Tage),
# die Zusage aus BACKEND.md Abschnitt 0, Punkt 8 - siehe src/settings.py.
# Diese Defaults sind zugleich die Obergrenze: kuerzer ist erlaubt, laenger nicht.
# Ein Wert ausserhalb stoppt den Start, nicht erst die erste Anfrage.
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=5184000
